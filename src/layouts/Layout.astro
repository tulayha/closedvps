---
import { Font } from "astro:assets";
import { site, org, page, markdown } from "../site.js";

const footer = "<footer><a href=\"/claude-code\">Claude Code on a VPS</a><a href=\"/sold-out\">When Hetzner is sold out</a><a href=\"/tailscale\">Tailscale for a VPS</a><a href=\"https://github.com/tulayha/closedvps/blob/main/LICENSE\">MIT licensed</a><a href=\"https://github.com/tulayha/closedvps\">Source</a><a href=\"https://github.com/tulayha/closedvps#security-model\">Security model</a><a href=\"/llms.txt\">llms.txt</a></footer>";

const { path, schema = [], notFound = false } = Astro.props;
const p = notFound ? { title: "Not found · ClosedVPS" } : page(path);
const url = site + path;
const article = Boolean(p.type);
const ld = [...schema];
if (article) {
  ld.push({
    "@context": "https://schema.org",
    "@type": p.type,
    headline: p.title,
    description: p.description,
    url,
    image: `${site}/og.png`,
    datePublished: p.published,
    dateModified: p.modified,
    author: org,
    publisher: org,
  });
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{p.title}</title>
{notFound && <meta name="robots" content="noindex">}
{!notFound && <meta name="description" content={p.description}>}
{!notFound && <link rel="canonical" href={url}>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{!notFound && (
  <Fragment>
    <meta property="og:type" content={article ? "article" : "website"}>
    <meta property="og:url" content={url}>
    <meta property="og:title" content={p.title}>
    <meta property="og:description" content={p.description}>
    <meta property="og:image" content={`${site}/og.png`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="A Hetzner server with every port closed: the internet is blocked by a firewall with 0 inbound rules, your laptop gets in over Tailscale">
    <meta property="og:site_name" content="ClosedVPS">
    {article && <meta property="article:published_time" content={p.published}>}
    {article && <meta property="article:modified_time" content={p.modified}>}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="alternate" type="text/markdown" href={markdown(path)}>
  </Fragment>
)}
<Font cssVariable="--font-geist" preload={[{ weight: "400", style: "normal" }]} />
<Font cssVariable="--font-geist-mono" />
<Font cssVariable="--font-newsreader" preload={[{ weight: "500", style: "normal" }]} />
<link rel="stylesheet" href="/site.css">
<script is:inline>try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
document.documentElement.classList.add("js");</script>
{ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
<div class="wrap">
<header class="top">
  <a class="brand" href="/"><svg class="i" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>ClosedVPS</a>
  <nav><a href="/why">Why</a><a href="/guide">Guide</a><a href="https://github.com/tulayha/closedvps">GitHub</a><button class="theme" type="button" aria-label="Switch light or dark"><svg class="i moon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg><svg class="i sun" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ><circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" /></svg></button></nav>
</header>
<slot />
{!notFound && <Fragment set:html={footer} />}
</div>
<script is:inline>
document.querySelector(".theme").addEventListener("click", () => {
  const root = document.documentElement;
  const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  root.dataset.theme = dark ? "light" : "dark";
  try { localStorage.setItem("theme", root.dataset.theme); } catch {}
});
</script>
<slot name="scripts" />
</body>
</html>
