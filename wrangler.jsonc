{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "closedvps",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "closedvps.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only the install scripts and closedvps's update check go through the Worker, which answers them from the
    // latest release and counts them.
    "run_worker_first": ["/install.sh", "/install.ps1", "/latest"]
  },
  "analytics_engine_datasets": [{ "binding": "INSTALLS", "dataset": "closedvps_installs" }],
  "observability": { "enabled": true }
}
